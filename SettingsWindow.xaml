<Window x:Class="VoicevoxEnterPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="設定"
        Height="400" Width="450"
        MinHeight="360" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
        KeyDown="Window_KeyDown">
    
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- エンジンURL -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="エンジンURL（50021: VOICEVOX / 50160: Nemo / 10101: AivisSpeech）" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="EngineUrlBox"
                         Style="{StaticResource ModernTextBox}"
                         FontSize="13"
                         KeyDown="EngineUrlBox_KeyDown"
                         LostFocus="EngineUrlBox_LostFocus"
                         ToolTip="変更すると話者一覧を再取得します"/>
            </StackPanel>

            <!-- 話者選択 -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="話者" Style="{StaticResource ModernLabel}"/>
                <ComboBox x:Name="SpeakerComboBox" 
                          Height="40" FontSize="14"
                          Style="{StaticResource ModernComboBox}"
                          ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                          IsEditable="False"/>
            </StackPanel>

            <!-- 発声前の無音時間 -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="発声前の無音（頭切れ防止）" 
                               Style="{StaticResource ModernLabel}"/>
                    <TextBlock x:Name="PrePhonemeValueText" Grid.Column="1"
                               Text="0.10 秒" FontSize="13"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
<Slider x:Name="PrePhonemeSlider"
        Minimum="0" Maximum="1.0"
        Value="0.10"
        SmallChange="0.01"
        LargeChange="0.05"
        TickFrequency="0.05"
        IsSnapToTickEnabled="False"
        IsMoveToPointEnabled="False"
        ValueChanged="PrePhonemeSlider_ValueChanged"
        VerticalAlignment="Center"
        Height="24"/>
                <UniformGrid Columns="2">
                    <TextBlock Text="0 秒" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="1.0 秒" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </UniformGrid>
            </StackPanel>

            <!-- ステータス -->
            <TextBlock x:Name="StatusText" Grid.Row="3" 
                       Style="{StaticResource StatusText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="話者一覧を取得中..."
                       Margin="0,8,0,0"/>

            <!-- ボタン -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnCancel" Content="キャンセル" Style="{StaticResource SecondaryButton}"
                        Click="BtnCancel_Click" Padding="16,8" FontSize="13"/>
                <Button x:Name="BtnOk" Content="OK" Style="{StaticResource ModernButton}"
                        Click="BtnOk_Click" Padding="20,8" FontSize="13" Margin="8,0,0,0"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>