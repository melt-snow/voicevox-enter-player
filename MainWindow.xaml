<Window x:Class="VoicevoxEnterPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VOICEVOX Enter Player"
        Height="180" Width="500"
        MinHeight="160" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Meiryo UI, Yu Gothic UI"
        KeyDown="Window_KeyDown">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 入力エリア -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="読み上げるテキストを入力して Enter キーで発声" Style="{StaticResource ModernLabel}"/>
            <TextBox x:Name="InputTextBox" 
                     Style="{StaticResource ModernTextBox}"
                     Height="50"
                     MaxLength="1000"
                     VerticalContentAlignment="Center"
                     KeyDown="InputTextBox_KeyDown"
                     TextChanged="InputTextBox_TextChanged"
                     ToolTip="Enter: 発声 / Shift+Enter: 改行 / 最大1000文字"/>
        </StackPanel>

        <!-- ステータスエリア + ボタンエリア（同一行右寄せ） -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="StatusText" Grid.Column="0" 
                       Style="{StaticResource StatusText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="エンジンに接続中..."
                       VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSettings" Content="⚙ 設定" Style="{StaticResource SecondaryButton}"
                        Click="BtnSettings_Click" Padding="16,8" FontSize="13"/>
                <Button x:Name="BtnSpeak" Content="▶ 発声 (Enter)" Style="{StaticResource ModernButton}"
                        Click="BtnSpeak_Click" Padding="20,10" FontSize="14" Margin="8,0,0,0"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>